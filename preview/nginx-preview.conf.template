# Rendered by the official Nginx entrypoint; only PREVIEW_* are substituted.
server {
    listen 80 default_server;
    root /usr/share/nginx/html;
    charset utf-8;
    client_max_body_size 100M;
    add_header X-Robots-Tag "noindex, nofollow" always;

    # All API traffic uses the existing gateway. No DB or backend container here.
    location ~ ^/(api|media|static)/ {
        proxy_pass http://${PREVIEW_GATEWAY};
        proxy_set_header Host ${PREVIEW_BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_redirect off;
        proxy_read_timeout 120s;
    }
    location /events {
        proxy_pass http://${PREVIEW_GATEWAY};
        proxy_http_version 1.1;
        proxy_set_header Host ${PREVIEW_BACKEND_HOST};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1h;
    }
    include /etc/nginx/snippets/frontend-locations.conf;
}
