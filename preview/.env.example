# Use a unique immutable tag; image is built locally and loaded on the VPS.
FRONTEND_IMAGE=hakoon/taiga-front:preview-20261015-01
PREVIEW_DOMAIN=taiga-homolog.hakoongames.com
PREVIEW_PORT=9002
PRODUCTION_DOMAIN=taiga.hakoongames.com
PRODUCTION_GATEWAY=taiga-gateway
PRODUCTION_NETWORK=taiga-docker_taiga
# Production events were stopped in the shared server snapshot. Enable only if available.
ENABLE_EVENTS=false
DEFAULT_LANGUAGE=en
